{
  "uid": "echoroom-capacity",
  "title": "EchoRoom capacity",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "HTTP p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{status=~\"2..\"}[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Send bytes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "echoroom_realtime_send_bytes",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Slow client closes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(echoroom_realtime_send_closed_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Admission rejects",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kind,mode) (rate(echoroom_traffic_rejected_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(echoroom_cache_requests_total{result=\"hit\"}[5m])) / sum(rate(echoroom_cache_requests_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "DB pool waiters",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "hikaricp_connections_pending",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Wallet lock p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le) (rate(echoroom_wallet_lock_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "Transaction p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95,sum by (le) (rate(echoroom_gift_transaction_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "MQ lag",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "echoroom_mq_consumer_lag",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Outbox age",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "echoroom_mq_outbox_oldest_age_seconds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "GC pause",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "Redis operations",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[5m])",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "MySQL connections",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "mysql_global_status_threads_connected",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Host available memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "echoroom-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes",
          "refId": "A"
        }
      ]
    }
  ]
}